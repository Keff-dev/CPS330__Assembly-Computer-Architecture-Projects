                                ; // c0902.c
   .start main                  ; #include <stdio.h>
   halt                         ; #include <stdlib.h>
A: .zero 2                      ; struct A 
                                ; {
                                   ; int x;  @a0
                                   ; char c; @a0
                                ; };
p: .word 0                      ; struct A *p;
f: push lr                      ; void f()
   push fp                      ; {
   mov fp, sp

   mov r1, 2                      ; p = (struct A *)malloc(sizeof(struct A));
   bl malloc
   st r0, p
   
   mov r0, 1                       ; p->x = 1;
   ld r1, p
   str r0, r1, 0

   mov r0, 65                      ; p->c = 'A';
   ld r1, p
   str r0, r1, 1

   mov sp, fp                   ; }
   pop fp
   pop lr
   ret
main: push lr                   ; int main()
      push fp                   ; {
      mov fp, sp

      bl f                          ; f();
      
      ld r0, p                     ; printf("%d\n", p->x);
      ldr r0, r0, 0
      dout r0
      nl

      ld r0, p                     ; printf("%c\n", p->c);
      ldr r0, r0, 1
      aout r0
      nl

      mov r0, 0                    ; return 0;
      mov sp, fp            ; }
      pop fp
      pop lr
      ret
malloc:  ld r0, @avail
         add r1, r0, r1
         st r1, @avail
         ret
@avail:  .word *+1