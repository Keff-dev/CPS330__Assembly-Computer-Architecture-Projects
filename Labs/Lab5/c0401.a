; // c0401.c
      .start main             ; #include <stdio.h>
g:    push lr                 ; void g() { ; printf("in g\n"); }
      push fp                 
      mov fp, sp
      lea r0, stm
      sout r0
      mov sp, fp
      pop fp
      pop lr
      ret
stm: .string "in g\n"
                                 
f:    push lr                 ; void f(void) { g(); }
      push fp
      mov fp, sp
      bl g
      mov sp, fp
      pop fp
      pop lr                              
      ret

main: bl f                    ; int main() { f()
      halt                    ; return 0; }
